# Postgres connection string. For local dev, point this at a local Postgres
# instance. For Vercel, use the connection string from your Neon (or other
# hosted Postgres) integration — Neon's pooled connection string is fine for
# both migrations and app queries.
DATABASE_URL="postgresql://user:password@localhost:5432/whereto"

# Optional. When set, WhereTo automatically switches from its built-in mock
# Bangalore venue/travel-time data to live Google Maps Platform data
# (Places, Distance Matrix, Geocoding, and Place Details for reviews/photos).
# Leave unset to run entirely offline with realistic mock data — no key
# required to develop or demo the app.
# GOOGLE_MAPS_API_KEY=
